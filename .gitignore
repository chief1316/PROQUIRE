# ==============================
# ProQuire Root Git Ignore
# ==============================

# Node dependencies
**/node_modules/

# Environment variables
**/.env
**/.env.*
!.env.example

# Build outputs
**/dist/
**/build/
**/.vite/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploaded/generated files
Backend/uploads/*
!Backend/uploads/.gitkeep

# IDE / editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# OS generated files
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp

# Local test artifacts
test-national-id.png.png
test_id_2.png